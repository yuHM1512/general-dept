APP_NAME="general-dept-tool"
APP_ENV="dev"
LOG_LEVEL="INFO"

# Web server
HOST="0.0.0.0"
PORT=8012

# Sessions (change this in production)
SESSION_SECRET=""

# Postgres (fill these in)
DATABASE_URL=""
DB_CONNECT_TIMEOUT=5

# App behavior
TARGET_SALARY_VND=5600000
WAGE_THRESHOLD=220000

# DB chứa bảng cm_daily (lương bình quân ngày từ Bravo 8)
# Nếu không set, dùng DATABASE_URL ở trên
AVG_SALARY_DATABASE_URL=""
PREVIEW_MAX_ROWS=20000
CREATE_TABLES_ON_STARTUP=true
ALLOW_LOCAL_INGEST=false

# Optional: default Excel path for local ingest
DEFAULT_EXCEL_PATH=""

# Survey module (Google Sheets sync)
SURVEY_SHEET_ID=""
SURVEY_DATA_TAB=""
SURVEY_CREDENTIALS_PATH=""

# Email nhắc HĐKP tự động (mặc định gửi mỗi ngày lúc 08:00, giờ Việt Nam)
AUDIT_REMINDER_ENABLED=false
AUDIT_REMINDER_TIME="08:00"
AUDIT_REMINDER_TIMEZONE="Asia/Bangkok"
AUDIT_REMINDER_POLL_SECONDS=60
AUDIT_REMINDER_BASE_URL="http://172.16.3.158:8012"
# Danh sách CC bổ sung, cách nhau bằng dấu phẩy; có thể để trống
AUDIT_REMINDER_CC=""

# Gmail/Google Workspace: SMTP_USERNAME là địa chỉ gửi, SMTP_PASSWORD là App Password 16 ký tự
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Hệ thống Đánh giá nội bộ"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
